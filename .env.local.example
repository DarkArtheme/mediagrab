# Local-run overrides on top of .env (cp .env.local.example .env.local).
# Loaded only by `uv run python -m reelsbot` and only from the repo root;
# Docker ignores this file (compose reads .env directly). Any variable set
# here wins over the same variable in .env; everything else (BOT_TOKEN,
# WHITELIST_USER_IDS, ...) still comes from .env.

# Local path to the burner account's cookies file (Netscape format).
IG_COOKIES_FILE=./instagram.txt

# Local SQLite cache (empty → ./cache.sqlite3).
DB_PATH=

# Temp downloads dir (empty → system temp dir).
DOWNLOAD_DIR=
