# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# api_id / api_hash from https://my.telegram.org (required by the Local Bot API Server)
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Base URL of the self-hosted Local Bot API Server.
# Leave empty to use the standard https://api.telegram.org (50 MB upload limit).
TELEGRAM_API_URL=http://telegram-bot-api:8081

# Comma-separated Telegram user IDs allowed to use the bot
WHITELIST_USER_IDS=111111111,222222222

# Telegram user ID that receives admin notifications (e.g. expired IG cookies)
ADMIN_USER_ID=111111111

# Path to the burner Instagram account's cookies in Netscape format
IG_COOKIES_FILE=/data/cookies/instagram.txt

# Path to the SQLite cache database
DB_PATH=/data/db/cache.sqlite3

# Directory for temporary downloads (defaults to the system temp dir if empty)
DOWNLOAD_DIR=
