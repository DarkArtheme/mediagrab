# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# OPTIONAL: api_id / api_hash from https://my.telegram.org — needed only for
# the self-hosted Local Bot API Server (2 GB uploads, compose profile
# "local-api"). Leave as-is when running against the cloud api.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Base URL of the self-hosted Local Bot API Server.
# Empty → the standard https://api.telegram.org (50 MB upload limit; no
# api_id/hash needed). Set to http://telegram-bot-api:8081 together with the
# "local-api" compose profile for 2 GB uploads.
TELEGRAM_API_URL=

# Version tag for the locally built bot image (docker compose); "dev" for
# untagged local builds, or X.Y.Z matching bot/pyproject.toml for releases
BOT_VERSION=dev

# Comma-separated Telegram user IDs allowed to use the bot
WHITELIST_USER_IDS=111111111,222222222

# Telegram user ID that receives admin notifications (e.g. expired IG cookies)
ADMIN_USER_ID=111111111

# Path to the burner Instagram account's cookies in Netscape format
IG_COOKIES_FILE=/data/cookies/instagram.txt

# TikTok cookies (Netscape format). TikTok works anonymously — leave empty
# unless anonymous extraction starts failing.
TIKTOK_COOKIES_FILE=

# Path to the SQLite cache database
DB_PATH=/data/db/cache.sqlite3

# Directory for temporary downloads (defaults to the system temp dir if empty)
DOWNLOAD_DIR=
